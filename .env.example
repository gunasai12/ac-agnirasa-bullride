# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_rotated_supabase_secret

# Razorpay TEST credentials only until checkout has been tested
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Resend transactional email
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM=Bull Ride Tickets <tickets@your-verified-domain.com>

# Public website origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Excel Online live bookings sync (optional until Microsoft setup is complete)
# Create a workbook in OneDrive/SharePoint and an Excel table named "Bookings".
# Table columns, in order:
# Booking ID, Paid At, Buyer Name, Buyer Email, Buyer Mobile, Package, Amount INR,
# Rider Name, Rider Course, Ticket Code, Razorpay Payment ID, Payment Status
MS_TENANT_ID=your_microsoft_tenant_id
MS_CLIENT_ID=your_microsoft_app_client_id
MS_CLIENT_SECRET=your_microsoft_app_client_secret
MS_EXCEL_DRIVE_ID=your_onedrive_or_sharepoint_drive_id
MS_EXCEL_WORKBOOK_ITEM_ID=your_excel_file_item_id
MS_EXCEL_TABLE_NAME=Bookings
