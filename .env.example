# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_rotated_supabase_secret

# Razorpay TEST credentials only until checkout has been tested
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Resend transactional email
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM=Bull Ride Tickets <tickets@your-verified-domain.com>

# Public website origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live Excel sync via Power Automate (recommended)
# Create a Power Automate flow with an HTTP request trigger and Excel Online (Business) "Add a row into a table" action.
# Keep the complete generated flow URL private; add it only in Vercel environment variables.
POWER_AUTOMATE_EXCEL_WEBHOOK_URL=your_private_power_automate_http_trigger_url
